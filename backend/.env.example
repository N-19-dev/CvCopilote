# Sécurité du chat
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CHAT_LIMIT_PER_VISITOR=10
CHAT_LIMIT_WINDOW_SECONDS=86400
CHAT_GLOBAL_DAILY_LIMIT=500
